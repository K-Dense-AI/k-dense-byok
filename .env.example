## Model access (choose one or more)

# OpenRouter API key — how Kady reaches hosted models (OpenAI, Anthropic,
# Google, xAI, Qwen, …). This can be blank if every chat uses a connected Pi
# subscription or local Ollama. OpenRouter Fusion and the server-side speech
# transcription fallback remain OpenRouter-only.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL. Because the provider is just an
# OpenAI-compatible endpoint, you can point it at any compatible gateway and
# keep using OPENROUTER_API_KEY for that gateway's key. For example, Requesty
# (https://requesty.ai) — caching, failover, and cost controls, same
# "vendor/model" ids:
#   OPENROUTER_BASE_URL=https://router.requesty.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Browsers without the Web Speech API use OpenRouter for transcription.
# SPEECH_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# NVIDIA NIM (build.nvidia.com) — direct access to Nemotron, Llama, GPT-OSS,
# and other NIM-served models (as `nvidia/<vendor>/<model>` in the picker).
# Usage draws on NVIDIA-managed API credits, not per-token dollar pricing, so
# it is recorded but never counted against a project spend cap. Can also be
# set live from Settings → API keys.
# NVIDIA_API_KEY=

# Extra NIM model ids to pin into the picker (comma/whitespace separated) —
# for private or early-access endpoints missing from Pi's NIM catalogue.
# Values are model ids exactly as sent to the API; no `nvidia/` ref prefix.
# NVIDIA_EXTRA_MODELS=private/vendor/example-model

# Any other provider Pi supports natively (https://pi.dev/docs/latest/providers)
# works with your own key. Set the variable here or paste it live under
# Settings → API keys → Direct model providers; each configured provider gets
# its own picker section as `<provider>/<model-id>`. Everything below is
# pay-as-you-go at Pi's list price and counts toward a project spend cap,
# except the prepaid token plans marked "plan", which (like NVIDIA NIM) are
# recorded but never cap-counted.
# ANTHROPIC_API_KEY=            # anthropic/…       (Claude Pro/Max is an OAuth login instead)
# OPENAI_API_KEY=               # openai/…          (ChatGPT Plus/Pro connects as openai-codex)
# GEMINI_API_KEY=               # google/…          (also the web-search fallback key below)
# XAI_API_KEY=                  # xai/…             (SuperGrok / X Premium is an OAuth login)
# DEEPSEEK_API_KEY=             # deepseek/…
# MISTRAL_API_KEY=              # mistral/…
# GROQ_API_KEY=                 # groq/…
# CEREBRAS_API_KEY=             # cerebras/…
# HF_TOKEN=                     # huggingface/<org>/<repo>
# FIREWORKS_API_KEY=            # fireworks/accounts/fireworks/models/…
# TOGETHER_API_KEY=             # together/<org>/<model>
# BASETEN_API_KEY=              # baseten/<org>/<model>
# AI_GATEWAY_API_KEY=           # vercel-ai-gateway/<vendor>/<model>
# OPENCODE_API_KEY=             # opencode/… and opencode-go/…
# KIMI_API_KEY=                 # kimi-coding/…     (Kimi Code plan is an OAuth login)
# MOONSHOT_API_KEY=             # moonshotai/… and moonshotai-cn/…
# MINIMAX_API_KEY=              # minimax/…
# MINIMAX_CN_API_KEY=           # minimax-cn/…
# ZAI_API_KEY=                  # zai/…
# ZAI_CODING_CN_API_KEY=        # zai-coding-cn/…
# QWEN_TOKEN_PLAN_API_KEY=      # qwen-token-plan/… and qwen-token-plan-individual/…  (plan)
# QWEN_TOKEN_PLAN_CN_API_KEY=   # qwen-token-plan-cn/…                                (plan)
# XIAOMI_API_KEY=               # xiaomi/…
# XIAOMI_TOKEN_PLAN_CN_API_KEY= # xiaomi-token-plan-cn/…   (plan)
# XIAOMI_TOKEN_PLAN_AMS_API_KEY= # xiaomi-token-plan-ams/… (plan)
# XIAOMI_TOKEN_PLAN_SGP_API_KEY= # xiaomi-token-plan-sgp/… (plan)
# ANT_LING_API_KEY=             # ant-ling/…
#
# Cloud platforms take a key plus configuration:
# AZURE_OPENAI_API_KEY=         # azure-openai-responses/<deployment or model>
# AZURE_OPENAI_BASE_URL=        #   https://<resource>.openai.azure.com  — or:
# AZURE_OPENAI_RESOURCE_NAME=   #   <resource>
# AZURE_OPENAI_API_VERSION=     #   optional
# AZURE_OPENAI_DEPLOYMENT_NAME_MAP=  # optional, model=deployment,model=deployment
# AWS_BEARER_TOKEN_BEDROCK=     # amazon-bedrock/…  — or AWS_PROFILE / AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY
# AWS_REGION=us-east-1
# GOOGLE_CLOUD_API_KEY=         # google-vertex/…   — or Application Default Credentials plus:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# CLOUDFLARE_API_KEY=           # cloudflare-ai-gateway/… and cloudflare-workers-ai/@cf/…
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=        #   AI Gateway only

# Pi OAuth logins need no key here. Connect ChatGPT Plus/Pro (openai-codex),
# Claude Pro/Max (anthropic), GitHub Copilot, xAI, Kimi Code, OpenRouter, or
# Radius in Settings → Model providers. Tokens default to
# ~/.kady/pi-agent/auth.json.
#
# Relocate Kady's private Pi credential/settings directory:
# KADY_PI_AGENT_DIR=/absolute/path/to/kady-pi-agent
#
# Or explicitly set Pi's own directory to intentionally share auth and settings
# with a standalone Pi installation. PI_CODING_AGENT_DIR takes precedence over
# KADY_PI_AGENT_DIR; the lead agent and subagents inherit the same directory.
# PI_CODING_AGENT_DIR=/absolute/path/to/pi-agent


## Model defaults (optional)

# Default model for the agent. This is the provider's model id; the provider is
# set below (openrouter, ollama, openai-compatible, or any Pi provider id such
# as nvidia, anthropic, openai, google, groq, amazon-bedrock, openai-codex,
# github-copilot, xai). You can also switch models per chat tab in the UI.
# Direct provider defaults require that provider's key or login to be set.
DEFAULT_MODEL_ID="openai/gpt-6-astra"
DEFAULT_MODEL_PROVIDER="openrouter"


## Optional: local Ollama server

# Host for a running `ollama serve`. Models pulled into Ollama show up in the
# model dropdown (as `ollama/<name>`) and run directly against your local
# daemon. Pick `DEFAULT_MODEL_ID` like `llama3` with DEFAULT_MODEL_PROVIDER or
# just choose an `ollama/*` model in the UI.
OLLAMA_BASE_URL=http://localhost:11434


## Optional: local OpenAI-compatible server

# Any local server exposing the standard OpenAI `/v1/models` and
# `/v1/chat/completions` endpoints — LM Studio, vLLM, text-generation-webui,
# llama.cpp's server, and so on. Loaded models appear in the picker under
# "Local (OpenAI-compatible)" as `openai-compatible/<model-id>`.
#
# Uncomment to switch the section on. It stays hidden until you set this or a
# server answers on the default port below (LM Studio's). vLLM defaults to
# 8000, which is this backend's port — move one of the two if you use vLLM.
# For local servers only: models are treated as free, so pointing this at a
# paid hosted gateway would leave that spend untracked and uncapped.
#OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234
# Use the ROOT, not a /v1 path: Kady appends /v1/models itself.
# Usually unnecessary: Kady reads each model's real context window off
# /v1/models (llama.cpp meta.n_ctx, vLLM max_model_len) and prefers it. Set this
# only as a fallback for servers that report nothing there — LM Studio, or a
# llama.cpp router listing a model it hasn't loaded yet. A window smaller than
# the prompt makes every run send ~0 output tokens.
#OPENAI_COMPATIBLE_CONTEXT_WINDOW=32768


## Optional: Modal remote compute

# Add Modal credentials to make on-demand cloud CPU/GPU machines available in
# each chat's compute selector. These can also be set live from Settings → API
# keys. Kady copies only the requested inputs to Modal and returns the selected
# outputs to the local project.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=


## Optional: web access (pi-web-access)

# Web search, URL/PDF fetching, GitHub repo reading, and video understanding
# work out of the box with no key (Exa MCP fallback). Add keys to unlock the
# direct providers — they can also be set live from Settings → API keys.
# EXA_API_KEY=            # exa.ai — fast web + code search
# PERPLEXITY_API_KEY=     # perplexity.ai — synthesized answers with citations
# GEMINI_API_KEY=         # Google AI Studio — search fallback + YouTube/video understanding


## Optional: backend knobs

# Override the backend port / projects directory if needed.
# KADY_PORT=8000
# KADY_PROJECTS_ROOT=./projects
# Optional Python override for bundled scientific-file preview helpers.
# KADY_PYTHON=python3

# Corporate/network proxy. Set these if your other tools only reach the
# internet through a proxy — Node does not pick them up on its own, so without
# them Kady dials providers directly and a filtering gateway can answer with
# 403s that don't come from the provider. NO_PROXY takes a comma-separated
# list of hosts to reach directly (keep localhost on it so Ollama still works).
# HTTPS_PROXY=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1


## Not used yet — being re-added as native tools

# The integrations below were part of the previous architecture and are not
# read by the current backend. They're listed here so you don't lose your
# values; first-party literature search and document conversion may return as
# native tools in upcoming releases. (Web access and Modal remote compute are
# already available — see the active sections above.)

# Web search
# PARALLEL_API_KEY=

# Paperclip literature / regulatory / clinical-trial search
# PAPERCLIP_API_KEY=

# Scientific databases and search
# NCBI_API_KEY=
# NCBI_EMAIL=
# S2_API_KEY=
# CORE_API_KEY=
# OPENALEX_API_KEY=

